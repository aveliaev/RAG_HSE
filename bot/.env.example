TELEGRAM_TOKEN=your_telegram_token
GROQ_API_KEY=your_groq_key

# YandexGPT (Яндекс Облако — console.cloud.yandex.ru → IAM → API-ключи)
YANDEX_API_KEY=your_yandex_api_key
YANDEX_FOLDER_ID=your_folder_id
# Модель: yandexgpt (Pro) | yandexgpt-lite (дешевле/быстрее) | yandexgpt-32k
YANDEX_MODEL=yandexgpt

# LLM-рерайт запроса перед поиском (true/false)
ENABLE_LLM_REWRITE=true


# Для /admin — твой Telegram user id
ADMIN_USER_ID=0

# Персональные данные
# Секретная соль для хеширования Telegram ID в логах. Сгенерировать: openssl rand -hex 32
LOG_SALT=
# Сколько дней хранить логи диалогов (0 — бессрочно)
LOG_RETENTION_DAYS=180
# Контакт для вопросов о персональных данных (показывается в /privacy)
PRIVACY_CONTACT=
